<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Installed by openscale service install; openscale service uninstall removes it. -->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.openscale.device</string>
	<key>ProgramArguments</key>
	<array>
		<string>/usr/local/bin/openscale</string>
		<string>up</string>
		<string>--config</string>
		<string>/etc/openscale/device.json</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<dict>
		<key>SuccessfulExit</key>
		<false/>
	</dict>
	<key>ThrottleInterval</key>
	<integer>10</integer>
	<key>ExitTimeOut</key>
	<integer>30</integer>
	<key>Umask</key>
	<integer>63</integer>
	<key>UserName</key>
	<string>root</string>
	<key>GroupName</key>
	<string>wheel</string>
	<key>ProcessType</key>
	<string>Standard</string>
	<key>WorkingDirectory</key>
	<string>/var/db/openscale/device</string>
	<key>StandardOutPath</key>
	<string>/var/log/openscale-device.log</string>
	<key>StandardErrorPath</key>
	<string>/var/log/openscale-device.log</string>
	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string>/usr/bin:/bin:/usr/sbin:/sbin</string>
	</dict>
</dict>
</plist>
