{
  "name": "openscale",
  "origin": "net/openscale",
  "version": "@VERSION@",
  "comment": "OpenScale WireGuard mesh VPN device",
  "desc": "OpenScale device for FreeBSD, pfSense and OPNsense: the tunnel and its rc.d service. Exit node, kill switch, subnet routing and MagicDNS are not available on FreeBSD yet (ADR-0090). Built locally with deploy/pfsense/build-pkg.sh; not tested on a real firewall.",
  "maintainer": "root@localhost",
  "www": "https://example.com/openscale",
  "abi": "@ABI@",
  "arch": "@ARCH@",
  "prefix": "/usr/local",
  "licenselogic": "single",
  "licenses": ["MIT"],
  "categories": ["net", "security"],
  "scripts": {
    "post-install": "install -d -m 0700 -o root -g wheel /var/db/openscale\nkldstat -q -m if_tun || kldload -n if_tun || true\necho 'OpenScale kuruldu. Katılım: openscale invite-join --state-dir /var/db/openscale --code @davet.txt'\necho 'Açmak için: sysrc -f /etc/rc.conf.d/openscale openscale_enable=YES && service openscale start'",
    "pre-deinstall": "/usr/local/etc/rc.d/openscale onestop >/dev/null 2>&1 || true",
    "post-deinstall": "echo 'Cihaz kimliği /var/db/openscale içinde kaldı; panelden iptal edip klasörü silin.'"
  }
}
