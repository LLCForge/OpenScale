# OpenScale (#446). After joining a network:
#   uci set openscale.main.enabled=1 && uci commit openscale && /etc/init.d/openscale restart
config openscale 'main'
	option enabled '0'
	# Device identity and the signed document; on flash so it survives a
	# reboot (/tmp is lost).
	option state_dir '/etc/openscale/device'
	option listen_port '41821'
	option interface 'OpenScale'
	# low (32 MiB target, #392) or default
	option memory_profile 'low'
	# More "openscale up" options, one per line, e.g.:
	# list extra_arg '--port-map'
