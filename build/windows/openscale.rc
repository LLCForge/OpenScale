// Windows resources of openscale.exe: icon, manifest and version info.
// Regenerate the .syso from build/windows after changing the icon or this file:
//   windres --target=pe-x86-64 -O coff -i openscale.rc -o ../../cmd/openscale/rsrc_windows_amd64.syso
#include <winver.h>

1 ICON "../../logos/app-icon.ico"
1 24 "openscale.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION 1,0,0,0
PRODUCTVERSION 1,0,0,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "041F04B0"
    BEGIN
      VALUE "CompanyName", "OpenScale"
      VALUE "FileDescription", "OpenScale"
      VALUE "FileVersion", "1.0.0-beta.2"
      VALUE "InternalName", "openscale"
      VALUE "OriginalFilename", "openscale.exe"
      VALUE "ProductName", "OpenScale"
      VALUE "ProductVersion", "1.0.0-beta.2"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x041F, 1200
  END
END
